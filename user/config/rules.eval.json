{
  "analysis": {
    "lineage_max_depth": 6,
    "recent_event_limit": 64,
    "max_per_process_artifacts": 16,
    "deep_chain_threshold": 5,
    "burst_open_threshold": 10,
    "burst_connect_threshold": 5,
    "burst_exec_threshold": 5,
    "burst_window_seconds": 10,
    "sensitive_history_window_seconds": 10,
    "suspicious_path_patterns": [
      "/tmp/",
      "/var/tmp/",
      "/dev/shm/",
      "/run/user/",
      "/proc/self/fd/",
      "/proc/"
    ],
    "sensitive_path_prefixes": [
      "/root/",
      "/var/run/secrets/",
      "/run/secrets/",
      "/var/lib/kubelet/",
      "/var/lib/docker/",
      "/var/lib/containerd/",
      "/home/ubuntu/Desktop/casa/evaluation/fake_fs/"
    ],
    "sensitive_path_patterns": [
      "/etc/shadow",
      "/etc/sudoers",
      "/.config/openclaw/",
      "/shadow"
    ],
    "shell_names": [
      "sh",
      "bash",
      "zsh",
      "dash",
      "ksh",
      "fish"
    ],
    "network_tool_names": [
      "curl",
      "wget",
      "nc",
      "netcat",
      "ncat",
      "socat",
      "ssh",
      "scp",
      "rsync"
    ],
    "interpreter_names": [
      "python",
      "python3",
      "perl",
      "ruby",
      "node",
      "php",
      "lua",
      "bash",
      "sh",
      "dash",
      "zsh"
    ],
    "container_runtime_names": [
      "docker",
      "containerd",
      "ctr",
      "runc",
      "crun",
      "podman",
      "nerdctl"
    ],
    "dangerous_capability_names": [
      "CAP_SYS_ADMIN",
      "CAP_NET_ADMIN",
      "CAP_NET_RAW",
      "CAP_SYS_PTRACE"
    ],
    "llm_provider_urls": [
      "https://generativelanguage.googleapis.com"
    ],
    "channel_urls": [],
    "known_cidrs": [],
    "allowed_loopback_ports": [
      18000
    ],
    "ignored_connect_ips": [
    ],
    "configured_connect_refresh_seconds": 300
  },
  "thresholds": {
    "log": 4,
    "alert": 9
  },
  "rules": [
    {
      "name": "memfd_or_deleted_exec",
      "description": "Execution from a memfd-backed or deleted binary path.",
      "expr": "execution.memfd_or_deleted_exec",
      "weight": 9,
      "enabled": true
    },
    {
      "name": "sensitive_file_then_network",
      "description": "Sensitive file access followed by outbound network activity.",
      "expr": "history.sensitive_then_network",
      "weight": 4,
      "enabled": true
    },
    {
      "name": "sensitive_file_exfiltration_via_tooling",
      "description": "Sensitive file access is followed by network activity through shell, interpreter, or network tooling.",
      "expr": "history.sensitive_then_network && (execution.shell_in_chain || execution.interpreter_in_chain || execution.network_tool_in_chain)",
      "weight": 5,
      "enabled": true
    },
    {
      "name": "sensitive_file_then_suspicious_exec",
      "description": "Sensitive file access is followed by execution from a suspicious path.",
      "expr": "history.sensitive_then_execve && execution.suspicious_path_exec",
      "weight": 6,
      "enabled": true
    },
    {
      "name": "download_then_suspicious_exec",
      "description": "Network activity is followed by execution from a suspicious path.",
      "expr": "history.connect_then_exec && execution.suspicious_path_exec",
      "weight": 6,
      "enabled": true
    },
    {
      "name": "download_then_shell_temp_exec",
      "description": "Connect-then-exec behavior is reinforced by shell, interpreter, or network tooling.",
      "expr": "history.connect_then_exec && execution.suspicious_path_exec && (execution.shell_in_chain || execution.network_tool_in_chain || execution.interpreter_in_chain)",
      "weight": 4,
      "enabled": true
    },
    {
      "name": "write_then_exec_same_path",
      "description": "A file is written and later executed from the same path.",
      "expr": "history.write_then_exec_same_path",
      "weight": 5,
      "enabled": true
    },
    {
      "name": "write_then_exec_from_suspicious_path",
      "description": "A written file is later executed from a suspicious temp-like path.",
      "expr": "history.write_then_exec_same_path && execution.suspicious_path_exec",
      "weight": 4,
      "enabled": true
    },
    {
      "name": "burst_network_scan",
      "description": "The session performs bursty outbound connections.",
      "expr": "history.burst_connect",
      "weight": 6,
      "enabled": true
    },
    {
      "name": "burst_exec_from_shell",
      "description": "Shell lineage launches a burst of executions.",
      "expr": "history.burst_exec && execution.shell_in_chain",
      "weight": 4,
      "enabled": true
    },
    {
      "name": "opened_deleted_path",
      "description": "A deleted path is still accessed through a live file descriptor or similar handle.",
      "expr": "history.opened_deleted_path",
      "weight": 5,
      "enabled": true
    },
    {
      "name": "dangerous_caps_without_seccomp",
      "description": "The process has dangerous capabilities while seccomp is disabled.",
      "expr": "capability.has_dangerous_caps && capability.seccomp_disabled",
      "weight": 8,
      "enabled": true
    }
  ]
}
